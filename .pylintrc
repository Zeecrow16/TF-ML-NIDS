[MASTER]
ignore=venv,__pycache__

[MESSAGES CONTROL]
enable=bad-indentation,
       trailing-whitespace,
       invalid-name,
       wrong-import-position,
       unused-import,
       unused-variable,
       too-many-locals,
       too-many-branches,
       too-many-statements

disable=all

enable=bad-indentation,
       trailing-whitespace,
       invalid-name,
       wrong-import-position,
       unused-import,
       unused-variable,
       too-many-locals,
       too-many-branches,
       too-many-statements

[FORMAT]
max-line-length=100
indent-string='    '

[BASIC]
variable-rgx=[a-z_][a-z0-9_]{2,30}$
function-rgx=[a-z_][a-z0-9_]{2,30}$
method-rgx=[a-z_][a-z0-9_]{2,30}$
attr-rgx=[a-z_][a-z0-9_]{2,30}$
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$
class-rgx=[A-Z_][a-zA-Z0-9]+$

[DESIGN]
max-locals=15
max-branches=12
max-statements=50